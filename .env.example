# Copy to .env and fill in real values. Never commit .env.
# Database (Neon Postgres, serverless HTTP driver)
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# His recurring Google Meet link, shown on booking confirmations
MEET_LINK=https://meet.google.com/abc-defg-hij

# Password for the /admin dashboard (any string you choose)
ADMIN_PASSWORD=change-me-to-something-long

# API key Jarvis uses for /api/admin/* (any random string; store it in the Secure Vault)
JARVIS_API_KEY=change-me-to-a-random-string

# SMTP for booking emails (Zoho ZeptoMail). If these are absent, emails are
# logged to the server console instead of being sent (dev fallback).
SMTP_HOST=smtp.zeptomail.com
SMTP_PORT=587
SMTP_USER=you@yourdomain.com
SMTP_PASS=your-zeptomail-password-or-token
SMTP_FROM=Meet <bookings@siv19.dev>

# Email address that receives "new booking" notifications (his email)
HOST_EMAIL=sivaganeshb193@gmail.com

# Public URL of the deployed app (used in emails + cancel links)
NEXT_PUBLIC_APP_URL=https://meet.siv19.dev

# IANA timezone for availability windows (his timezone)
TZ_NAME=America/New_York
